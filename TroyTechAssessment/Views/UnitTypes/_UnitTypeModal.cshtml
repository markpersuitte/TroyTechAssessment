@model TroyTechAssessment.Controllers.UnitTypesController.UnitTypeInput
<div class="modal fade" id="serverModal" tabindex="-1" data-open="true"><div class="modal-dialog"><div class="modal-content">
    <form method="post" action="@Url.Action("Save", "UnitTypes")" data-server-modal-form>
        @Html.AntiForgeryToken()
        <div class="modal-header"><h2 class="modal-title fs-5">@(Model.Id.HasValue ? "Edit unit type" : "Add unit type")</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span>
            <div class="form-check mt-3"><input asp-for="Active" class="form-check-input" /><label asp-for="Active" class="form-check-label"></label></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save</button></div>
    </form>
</div></div></div>
