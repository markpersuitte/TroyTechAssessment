@using TroyTechAssessment.Data
@model TroyTechAssessment.Pages.IndexModel
@{
    var isEditing = Model.Section == "editunit";
    var isUnitModalOpen = Model.Section is "unit" or "editunit";
}

@if (isUnitModalOpen)
{
<div class="modal fade" id="unitModal" tabindex="-1" aria-labelledby="unitModalLabel"
     aria-hidden="true" data-open="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="unitModalLabel">@(isEditing ? "Edit unit" : "Add unit")</h2>
                    <a class="btn-close" asp-page="/Index" aria-label="Close"></a>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Input.Action" value="@(isEditing ? "EditUnit" : "AddUnit")" />
                    <input type="hidden" asp-for="Input.UnitId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Number" class="form-label"></label>
                        <input asp-for="Input.Number" class="form-control" />
                        <span asp-validation-for="Input.Number" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Bedrooms" class="form-label"></label>
                        <select asp-for="Input.Bedrooms" class="form-select">
                            <option value="0">Select bedrooms</option>
                            @foreach (var bedroomCount in Unit.BedroomOptions.OrderBy(c => c))
                            {
                                <option value="@bedroomCount">@bedroomCount</option>
                            }
                        </select>
                        <span asp-validation-for="Input.Bedrooms" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.MonthlyRent" class="form-label">Monthly rent</label>
                        <input asp-for="Input.MonthlyRent" class="form-control" min="0.01" step="0.01" />
                        <span asp-validation-for="Input.MonthlyRent" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.PropertyId" class="form-label">Property</label>
                        <select asp-for="Input.PropertyId" class="form-select">
                            <option value="0">Select a property</option>
                            @foreach (var property in Model.Properties)
                            {
                                <option value="@property.Id">@property.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Input.PropertyId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.UnitTypeId" class="form-label">Type</label>
                        <select asp-for="Input.UnitTypeId" asp-items="Model.UnitTypes" class="form-select">
                            <option value="0">Select a unit type</option>
                        </select>
                        <span asp-validation-for="Input.UnitTypeId" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-secondary" asp-page="/Index">Cancel</a>
                    <button type="submit" class="btn btn-primary">@(isEditing ? "Save changes" : "Add unit")</button>
                </div>
            </form>
        </div>
    </div>
</div>
}