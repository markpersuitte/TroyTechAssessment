@model TroyTechAssessment.Pages.ApplyModel

<section id="application-summary" class="@((Model.Input.CurrentSection == "Summary" || Model.IsReadOnly) ? string.Empty : "d-none") mt-4" data-apply-step>
    <h2 class="h4">Summary</h2>
    @if (Model.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger">
            <h3 class="h6">Items blocking submission</h3>
            <ul class="mb-0">
                @foreach (var error in Model.ModelState.Values.SelectMany(value => value.Errors)
                              .Select(error => error.ErrorMessage)
                              .Where(message => !string.IsNullOrWhiteSpace(message))
                              .Distinct())
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5">Applicant information</h3>
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9" id="summary-name">@Model.Input.FirstName @Model.Input.LastName</dd>
                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9" id="summary-email">@Model.Input.Email</dd>
                <dt class="col-sm-3">Phone</dt>
                <dd class="col-sm-9" id="summary-phone">@Model.Input.PhoneNumber</dd>
                <dt class="col-sm-3">Current address</dt>
                <dd class="col-sm-9" id="summary-current-address">
                    @Model.Input.CurrentStreetAddress, @Model.Input.CurrentCity,
                    @Model.Input.CurrentState @Model.Input.CurrentZipCode
                </dd>
            </dl>
        </div>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5">Residence history</h3>
            <div id="summary-residence-history">
                @if (Model.Input.ResidenceHistory.Count == 0)
                {
                    <p class="mb-0">No residence history was provided.</p>
                }
                else
                {
                    @for (var index = 0; index < Model.Input.ResidenceHistory.Count; index++)
                    {
                        var residence = Model.Input.ResidenceHistory[index];
                        <div class="border rounded p-3 mb-3">
                            <h4 class="h6">Residence @(index + 1)</h4>
                            <dl class="row mb-0">
                                <dt class="col-sm-3">Address</dt>
                                <dd class="col-sm-9">@residence.StreetAddress, @residence.City, @residence.State @residence.ZipCode</dd>
                                <dt class="col-sm-3">Landlord</dt>
                                <dd class="col-sm-9">@residence.LandlordFirstName @residence.LandlordLastName (@residence.LandlordPhoneNumber)</dd>
                                <dt class="col-sm-3">Dates</dt>
                                <dd class="col-sm-9">@residence.MoveInDate?.ToString("M/d/yyyy") - @(residence.MoveOutDate?.ToString("M/d/yyyy") ?? "Present")</dd>
                            </dl>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
    <div class="mt-4">
        @if (!Model.IsReadOnly)
        {
            <button type="submit" name="Input.Action" value="BackToResidence" class="btn btn-secondary" formnovalidate>Previous</button>
            <button type="submit" name="Input.Action" value="SaveDraft"
                    class="btn btn-outline-primary" formnovalidate>
                Save Draft
            </button>
            <button type="submit" name="Input.Action" value="Submit" class="btn btn-primary">
                Submit application
            </button>
        }
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </div>
</section>
