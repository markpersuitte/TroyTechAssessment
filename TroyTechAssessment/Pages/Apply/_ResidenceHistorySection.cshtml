@model TroyTechAssessment.Pages.ApplyModel

<section id="residence-step" data-apply-step class="@((Model.Input.CurrentSection == "Residence" || Model.IsReadOnly) ? string.Empty : "d-none")">
    <h2 class="h4">Residence history</h2>
    <div id="residence-history-rows">
        @for (var index = 0; index < Model.Input.ResidenceHistory.Count; index++)
        {
            var residence = Model.Input.ResidenceHistory[index];
            <article class="residence-history-row border rounded p-3 mb-3">
                @if (!Model.IsReadOnly)
                {
                    <div class="d-flex gap-2 float-end">
                        <button type="button" class="btn btn-outline-primary" accesskey
                                data-modal-url="@Url.Action("Modal", "Residence", new
                            {
                                applicationId = Model.Input.ApplicationId,
                                residenceId = residence.Id
                            })">Edit</button>
                        <button type="button" class="btn btn-outline-danger"
                                data-delete-url="@Url.Action("Delete", "Residence", new
                             {
                                 applicationId = Model.Input.ApplicationId,
                                 residenceId = residence.Id
                             })"
                                data-concurrency-token="@Model.Input.ConcurrencyToken">Remove</button>
                    </div>
                }
                <h3 class="h6">Residence @(index + 1)</h3>
                <dl class="row mb-0">
                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">
                        @residence.StreetAddress, @residence.City,
                        @residence.State @residence.ZipCode
                    </dd>
                    <dt class="col-sm-3">Landlord</dt>
                    <dd class="col-sm-9">
                        @residence.LandlordFirstName @residence.LandlordLastName
                        (@residence.LandlordPhoneNumber)
                    </dd>
                    <dt class="col-sm-3">Dates</dt>
                    <dd class="col-sm-9">
                        @residence.MoveInDate?.ToString("M/d/yyyy") -
                        @(residence.MoveOutDate?.ToString("M/d/yyyy") ?? "Present")
                    </dd>
                </dl>
            </article>
        }
    </div>
    @if (!Model.IsReadOnly)
    {
        <button type="button" class="btn btn-outline-secondary"
                data-modal-url="@Url.Action("Modal", "Residence", new
                {
                    applicationId = Model.Input.ApplicationId
                })">
            Add residence
        </button>
    }
    <div class="mt-4">
        @if (!Model.IsReadOnly)
        {
            <button type="submit" name="Input.Action" value="BackToApplication" class="btn btn-secondary" formnovalidate>Previous</button>
            <button type="submit" name="Input.Action" value="SaveDraft"
                    class="btn btn-outline-primary" formnovalidate>Save Draft</button>
            <button type="submit" name="Input.Action" value="ContinueResidence" class="btn btn-primary">Continue</button>
        }
        <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
    </div>
</section>
