@model TroyTechAssessment.Pages.UnitTypes.UnitTypesModel

<div class="d-flex justify-content-between align-items-center mb-3">
    <a class="btn btn-primary" asp-page="/UnitTypes/UnitTypes" asp-route-section="unittype">
        Add unit type
    </a>
</div>

@if (Model.UnitTypes.Count == 0)
{
    <p>No unit types have been added.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Name</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var unitType in Model.UnitTypes)
            {
                <tr>
                    <td>@unitType.UnitTypeName</td>
                    <td>@(unitType.Active ? "Yes" : "No")</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary"
                           asp-page="/UnitTypes/UnitTypes"
                           asp-route-section="editunittype"
                           asp-route-unitTypeId="@unitType.Id">
                            Edit
                        </a>
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteUnitTypeModal-@unitType.Id">
                            Delete
                        </button>
                        @await Component.InvokeAsync("ConfirmModal", new
                        {
                            modalId = $"deleteUnitTypeModal-{unitType.Id}",
                            text = $"Are you sure you want to delete unit type {unitType.UnitTypeName}?",
                            action = "DeleteUnitType",
                            unitTypeId = unitType.Id,
                            page = "/UnitTypes/UnitTypes"
                        })
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
